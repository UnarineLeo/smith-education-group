rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerByUid(userId) {
      return isSignedIn() && userId == request.auth.uid;
    }

    function isOwnerByEmail(userId) {
      return isSignedIn()
        && request.auth.token.email != null
        && userId == request.auth.token.email;
    }

    function isOwnerDoc(userId) {
      return isOwnerByUid(userId) || isOwnerByEmail(userId);
    }

    match /users/{userId} {
      allow read: if isOwnerDoc(userId);

      allow create: if isOwnerDoc(userId)
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isOwnerDoc(userId)
        && resource.data.uid == request.auth.uid;
    }
  }
}